# Match POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB in the root .env.
DATABASE_URL=postgresql+psycopg://sales:replace-with-a-local@localhost:5432/sales_analytics
FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional, backend only. Empty token disables delivery with a startup warning.
# Chats subscribe through /start and unsubscribe through /stop; no chat ID is required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=3

# Optional USD/Toman display: obtain a Navasan API key; never use a frontend variable.
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://api.navasan.tech/latest/
EXCHANGE_RATE_CACHE_TTL_SECONDS=120
EXCHANGE_RATE_TIMEOUT_SECONDS=5

